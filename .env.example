# Assignment & Report Compliance Checker Environment Configuration

# Optional: Provide one or both API keys to enable LLM-powered rubric parsing,
# advanced content quality auditing, and Vision-based OCR for scanned PDFs.
# If left blank, the application will operate seamlessly in local heuristic mode!

# Primary AI Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional Secondary Fallback: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite Database Location
DATABASE_PATH=compliance_history.db

# Default tolerances
DEFAULT_MARGIN_TOLERANCE_INCHES=0.15
DEFAULT_FONT_SIZE_TOLERANCE_PT=0.75
