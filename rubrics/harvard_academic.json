{
  "rubric_id": "harvard_academic_std",
  "title": "Harvard Academic Report Style",
  "description": "Harvard Business & Academic report submission rules: Harvard Author-Date citation style, 11pt Arial or Calibri, 1-inch margins, 1.5 line spacing.",
  "formatting": {
    "expected_font": "Arial",
    "allowed_fonts": ["Arial", "Calibri", "Helvetica"],
    "expected_font_size_pt": 11.0,
    "font_size_tolerance_pt": 0.75,
    "expected_margin_inches": 1.0,
    "margin_tolerance_inches": 0.15,
    "expected_line_spacing": 1.5,
    "expected_page_size": "A4",
    "min_word_count": 1500,
    "max_word_count": 5000,
    "min_page_count": 3,
    "max_page_count": 15
  },
  "structure": {
    "required_sections": [
      "Executive Summary",
      "Introduction",
      "Literature Review",
      "Analysis",
      "Recommendations",
      "Conclusion",
      "References"
    ],
    "enforce_order": true,
    "min_words_per_section": {
      "Executive Summary": 150,
      "Introduction": 200,
      "Recommendations": 150
    }
  },
  "citations": {
    "citation_style": "Harvard",
    "require_reference_list": true,
    "min_references_count": 5,
    "cross_reference_in_text": true
  },
  "metadata": {
    "require_student_name": true,
    "require_student_id": true,
    "require_course_code": true,
    "course_code_pattern": "[A-Z]{2,4}\\s*[-_]?\\s*\\d{3,4}",
    "require_date": true,
    "header_or_cover_only": true
  },
  "content_quality": {
    "max_sentence_length_words": 35,
    "forbidden_vague_words": [
      "things",
      "stuff",
      "obviously",
      "bad",
      "basically"
    ],
    "min_lexical_diversity": 0.36,
    "enable_llm_quality_review": false
  }
}
